{
  "name": "katipan",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "fix-deps": "expo install --fix",
    "build:db": "node tools/build-bible-db.js",
    "build:daily": "node tools/generate-daily-verses.js",
    "build:manifest": "node tools/build-manifest.js",
    "apk:local": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "expo-router": "~58.0.0",
    "expo-sqlite": "~58.0.14",
    "expo-file-system": "~58.0.0",
    "expo-notifications": "~58.0.0",
    "expo-background-fetch": "~58.0.11",
    "expo-task-manager": "~58.0.0",
    "expo-crypto": "~58.0.0",
    "expo-sharing": "~58.0.0",
    "expo-intent-launcher": "~58.0.0",
    "expo-document-picker": "~58.0.0",
    "expo-clipboard": "~58.0.0",
    "expo-network": "~58.0.0",
    "expo-localization": "~58.0.0",
    "expo-font": "~58.0.0",
    "expo-keep-awake": "~58.0.0",
    "expo-asset": "~58.0.0",
    "expo-constants": "~58.0.0",
    "expo-linking": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-system-ui": "~58.0.0",
    "expo-build-properties": "~58.0.0",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-view-shot": "*",
    "@shopify/flash-list": "*",
    "zustand": "*",
    "@noble/ed25519": "*"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "*",
    "typescript": "*"
  }
}
